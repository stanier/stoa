# =============================================================================
# LLM credentials and endpoints
# =============================================================================
# Provider selection, model, and titling options live in the YAML config
# (config/config.example.yaml).  Only API keys, endpoint URLs, and TLS settings
# belong here.  The YAML config specifies which env var names to read via
# llm.api_key_env and llm.api_url_env.

# LLM API keys are stored as podman secrets, NOT in this file.
# Create them once before running compose:
#
#   echo "sk-ant-..." | podman secret create anthropic_api_key -
#   echo "sk-..."     | podman secret create openai_api_key -
#   echo "..."        | podman secret create gemini_api_key -
#   echo "..."        | podman secret create arcee_api_key -
#
# agentd reads them via *_API_KEY_FILE env vars pointing to /run/secrets/* mount paths.

# Endpoint URLs (not secrets — safe to put here)
# The env var name here must match api_url_env in your provider's YAML config block.
GATEWAY_API_URL=https://api.anthropic.com
# OPENAI_API_URL=https://api.openai.com/v1
ARCEE_API_URL=https://api.arcee.ai/v2

# =============================================================================
# Auth stack (postgres + local-idp + authd)
# =============================================================================

# Postgres passwords — one per database instance, intentionally separate.
# Each service only has credentials for its own database.
# Generate with: openssl rand -hex 32
AGENTD_DB_PASSWORD=change-me-in-production
AUTHD_DB_PASSWORD=change-me-in-production
LOCAL_IDP_DB_PASSWORD=change-me-in-production
APIKEYD_DB_PASSWORD=change-me-in-production

# Shared secret between local-idp and authd for the "local" OIDC provider.
# Any random string works — generate with: openssl rand -hex 32
AUTHD_OAUTH_LOCAL_CLIENT_SECRET=change-me-in-production

# Admin token for authd's /token/service endpoint and auth-admin CLI.
# Generate with: openssl rand -hex 32
AUTHD_ADMIN_TOKEN=change-me-in-production

# Public base URL authd is reachable at from browsers.
# Dev: localhost:8888 (port is exposed). Prod: your public domain.
AUTHD_EXTERNAL_URL=http://localhost:8888

# Internal issuer URL for local-idp — used by authd for OIDC discovery and
# token/userinfo calls over the internal container network. Never browser-facing.
LOCAL_IDP_ISSUER=http://local-idp:9999

# Browser-facing base URL for local-idp's login form (authorization_endpoint only).
# Dev: localhost:9999 (port 9999 is exposed). Prod: your public domain.
LOCAL_IDP_EXTERNAL_URL=http://localhost:9999

# Allowed redirect URIs for local-idp — must include authd's callback URL.
# This must match AUTHD_EXTERNAL_URL + /oauth/callback.
LOCAL_IDP_REDIRECT_URIS=http://localhost:8888/oauth/callback

# Public URL webd is reachable at from browsers.
WEBD_EXTERNAL_URL=http://localhost:3000

# Garage S3-compatible object storage (used by webd for file uploads).
# Generate with:
#   GARAGE_RPC_SECRET:       openssl rand -hex 32
#   GARAGE_ACCESS_KEY_ID:    openssl rand -hex 16
#   GARAGE_SECRET_ACCESS_KEY: openssl rand -hex 32
GARAGE_BUCKET=uploads
GARAGE_RPC_SECRET=change-me-rpc-secret
GARAGE_ADMIN_TOKEN=change-me-admin-token
GARAGE_ACCESS_KEY_ID=change-me-key-id
GARAGE_SECRET_ACCESS_KEY=change-me-secret-key

# Shared HMAC secret between webd and mcp-attachments. Used to sign opaque
# attachment IDs so the agent never sees S3 URLs or internal hostnames.
# Generate with: openssl rand -hex 32
ATTACHMENT_SECRET=change-me-attachment-secret

# Public URL apikeyd is reachable at from browsers (used for the OIDC callback).
APIKEYD_EXTERNAL_URL=http://localhost:8889

# Origins authd will redirect browsers back to after login.
# Comma-separated list — must include webd AND apikeyd so both can complete
# the OIDC callback after a user logs in to manage their API keys.
AUTHD_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:8889

# Service account token for zulip-bridge to authenticate against agentd.
# Generate AFTER first boot with:
#   docker compose run --rm migrate-authd \
#     authd service create zulip-bridge
# Then paste the printed token here and restart zulip-bridge.
ZULIP_BRIDGE_SERVICE_TOKEN=

# =============================================================================
# Zulip Integration (zulip-bridge container)
# =============================================================================

ZULIP_ENABLED=false
ZULIP_SITE_URL=https://your-org.zulipchat.com
ZULIP_EMAIL=bot@your-org.zulipchat.com
ZULIP_API_KEY=
ZULIP_COMMAND_PREFIX=!

# Zulip MCP server credentials (can be the same bot account as above)
ZULIP_MCP_BASE_URL=https://your-org.zulipchat.com
ZULIP_MCP_EMAIL=bot@your-org.zulipchat.com
ZULIP_MCP_API_KEY=

# =============================================================================
# MCP Server Credentials
# =============================================================================

NETBOX_BASE_URL=https://netbox.example.com/
NETBOX_TOKEN=

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARDS=

PROMETHEUS_BASE_URL=http://prometheus.example.com
GRAPHQL_ENDPOINT=https://api.example.com/graphql

# =============================================================================
# Podman (compose runtime)
# =============================================================================
# XDG_RUNTIME_DIR is usually set automatically by your session manager.
# Override here only if compose can't find the Podman socket.
# XDG_RUNTIME_DIR=/run/user/1000

# =============================================================================
# Optional overrides (defaults shown — uncomment to change)
# =============================================================================

# TRACE_ENABLED=true
# TRACE_DIR=~/.config/stoa/traces

# PERMISSIONS_ENABLED=true
# PERMISSIONS_DEFAULT_RANK=2
# PERMISSIONS_AUDIT_LOG=true

# PROMPTS_ENABLED=true
# PROMPTS_DIR=~/.config/stoa/prompts
