{
  "uid": "stoa-infgw",
  "title": "Inference Gateway",
  "tags": ["stoa"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Completions",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Completion Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "options": { "legend": { "displayMode": "list" } },
      "targets": [
        {
          "expr": "sum by (model, status) (rate(infgw_completions_total[5m]))",
          "legendFormat": "{{model}} / {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(infgw_completions_total{status=\"error\"}[5m])) / sum by (model) (rate(infgw_completions_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Tokens",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 5,
      "title": "Input Tokens / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(infgw_input_tokens_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Output Tokens / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(infgw_output_tokens_total[5m]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Upstream Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 8,
      "title": "Upstream Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (upstream, status) (rate(infgw_upstream_requests_total[5m]))",
          "legendFormat": "{{upstream}} / {{status}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Upstream Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2 },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (upstream, le) (rate(infgw_upstream_duration_seconds_bucket[5m])))",
          "legendFormat": "{{upstream}} p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (upstream, le) (rate(infgw_upstream_duration_seconds_bucket[5m])))",
          "legendFormat": "{{upstream}} p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (upstream, le) (rate(infgw_upstream_duration_seconds_bucket[5m])))",
          "legendFormat": "{{upstream}} p99"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Go Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": true,
      "panels": [
        {
          "id": 11,
          "title": "Goroutines",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "targets": [
            {
              "expr": "go_goroutines{job=\"inference-gateway\"}",
              "legendFormat": "goroutines"
            }
          ]
        },
        {
          "id": 12,
          "title": "Heap Memory",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": { "defaults": { "unit": "bytes" } },
          "targets": [
            {
              "expr": "go_memstats_heap_alloc_bytes{job=\"inference-gateway\"}",
              "legendFormat": "heap alloc"
            },
            {
              "expr": "go_memstats_heap_inuse_bytes{job=\"inference-gateway\"}",
              "legendFormat": "heap inuse"
            }
          ]
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "hide": 0
      }
    ]
  }
}
